{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>zekihan/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "SOPS parses with go.yaml.in/yaml/v3; internal/decrypt/policy.go must use the same parser",
      "matchPackageNames": [
        "go.yaml.in/yaml/v3"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
